# Frontend Environment Variables

# Google OAuth Client ID for Patient Sign-In JS SDK
# NOTE: NEXT_PUBLIC_GOOGLE_CLIENT_ID is separate from the backend's GOOGLE_OAUTH_CLIENT_ID.
# The backend uses GOOGLE_OAUTH_CLIENT_ID to verify Google ID tokens server-side.
# The frontend uses NEXT_PUBLIC_GOOGLE_CLIENT_ID to render the Google Sign-In JS SDK button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
